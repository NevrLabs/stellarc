[Unit]
Description=Stellarc Orbit %i — agent runtime holder (ACP children)
# After= only (boot ordering hint). NO Requires=: orbits must survive axis
# restarts (ADR 0008 §2) — orbit reconnects to the axis socket on its own.
After=stellarc-axis.service

[Service]
Type=simple
# Per-instance env: STELLARC_NODE_ID = orbit-%i (the node id registered with Axis).
Environment="STELLARC_NODE_ID=orbit-%i"
# PATH includes Hermes and the separately provisioned Codex launcher. Claude's
# locked ACP adapter is invoked by absolute path under ~/.stellarc/adapters/.
Environment="PATH=/home/rpw/.local/bin:/home/rpw/.bun/bin:/home/rpw/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/rpw/.stellarc/bin/stellarc-orbit
# on-failure (not always): a drained orbit that exits 0 stays down (ADR §5).
Restart=on-failure
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target
