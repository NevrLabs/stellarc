{
	"$schema": "https://turbo.build/schema.json",
	"globalEnv": [
		"CORS_ORIGINS",
		"DEPLOYMENT_ENVIRONMENT",
		"GITHUB_BASE_REF",
		"KANEO_API_URL",
		"KANEO_CLIENT_URL",
		"OTEL_EXPORTER_OTLP_ENDPOINT",
		"PG_BIN",
		"SERVICE_VERSION",
		"STELLARC_NODE_TOKEN",
		"STELLARC_OPERATOR_TOKEN"
	],
	"tasks": {
		"build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
		"@stellarc/gateway#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/packages/core-auth/src/**",
				"$TURBO_ROOT$/apps/toolgw/src/**",
				"$TURBO_ROOT$/apps/llmgw/src/**",
				"$TURBO_ROOT$/packages/telemetry/src/**"
			],
			"outputs": ["dist/**"]
		}
	}
}
