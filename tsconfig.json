{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"allowImportingTsExtensions": true
	},
	"include": ["apps/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "vitest*.ts"],
	"exclude": ["apps/stellarc-ui/**", "packages/contracts/src/legacy/**", "node_modules"]
}
