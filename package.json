{
	"name": "stellarc",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"test:integration": "bun --bun x vitest run --config vitest.integration.config.ts",
		"test:unit": "bun --bun x vitest run --config vitest.config.ts",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"build": "turbo run build"
	},
	"dependencies": {
		"@effect/platform": "0.97.0",
		"@effect/platform-bun": "0.90.0",
		"@effect/sql-pg": "0.53.0",
		"@electric-sql/client": "1.5.27",
		"@tanstack/db": "0.8.7",
		"@tanstack/electric-db-collection": "0.4.7",
		"effect": "3.22.0",
		"postgres": "3.4.7"
	},
	"devDependencies": {
		"vitest": "4.1.10",
		"typescript": "5.8.3",
		"@types/bun": "1.3.10",
		"@biomejs/biome": "2.4.6",
		"turbo": "2.8.17"
	}
}
