{
	"name": "stellarc",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"workspaces": [
		"apps/*",
		"packages/*",
		"packages/contracts/src/legacy/permissions"
	],
	"scripts": {
		"test:integration": "bun --bun x vitest run --config vitest.integration.config.ts",
		"test:unit": "bun --bun x vitest run --config vitest.config.ts",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"typecheck:ui": "tsc --noEmit --pretty false -p apps/stellarc-ui/tsconfig.app.json",
		"build": "turbo run build",
		"desktop:build": "DESKTOP_API_URL=${DESKTOP_API_URL:-https://api.stellarc.dev} bash desktop/scripts/build-ui.sh && bun run --cwd desktop tauri build -c target/tauri.conf.build.json",
		"desktop:check": "cargo check --manifest-path desktop/Cargo.toml --all-targets",
		"mobile:build": "MOBILE_API_URL=${MOBILE_API_URL:-https://api.stellarc.dev} bash mobile/scripts/build-ui.sh && bun run --cwd mobile tauri build -c target/tauri.conf.build.json",
		"mobile:check": "cargo check --manifest-path mobile/Cargo.toml --all-targets",
		"e2e": "playwright test",
		"e2e:screens": "playwright test frozen.spec.ts",
		"otel:up": "docker compose -f docker-compose.otel.yml up -d"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "1.7.0",
		"@aws-sdk/client-s3": "3.1090.0",
		"@aws-sdk/s3-request-presigner": "3.1090.0",
		"@better-auth/api-key": "1.6.23",
		"@better-auth/drizzle-adapter": "1.6.23",
		"@effect/opentelemetry": "0.64.0",
		"@effect/platform": "0.97.0",
		"@effect/platform-bun": "0.90.0",
		"@effect/sql": "0.52.1",
		"@effect/sql-drizzle": "0.51.0",
		"@effect/sql-pg": "0.53.0",
		"@electric-sql/client": "1.5.27",
		"@hono/node-server": "2.0.10",
		"@hono/node-ws": "1.3.1",
		"@hono/standard-validator": "0.3.0",
		"@modelcontextprotocol/sdk": "1.29.0",
		"@octokit/webhooks": "14.2.0",
		"@opentelemetry/exporter-logs-otlp-http": "0.203.0",
		"@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
		"@opentelemetry/exporter-trace-otlp-http": "0.222.0",
		"@opentelemetry/sdk-logs": "0.203.0",
		"@opentelemetry/sdk-metrics": "2.11.0",
		"@opentelemetry/sdk-trace-base": "2.11.0",
		"@oslojs/crypto": "1.0.1",
		"@oslojs/encoding": "1.1.0",
		"@paralleldrive/cuid2": "3.3.0",
		"@react-email/components": "1.0.12",
		"@sentry/node": "10.68.0",
		"@tanstack/db": "0.8.7",
		"@tanstack/electric-db-collection": "0.4.7",
		"@types/node": "25.8.0",
		"@types/nodemailer": "7.0.11",
		"@valibot/to-json-schema": "1.7.1",
		"bcryptjs": "3.0.2",
		"better-auth": "1.6.25",
		"croner": "10.0.1",
		"dotenv-mono": "^1.5.1",
		"drizzle-orm": "0.45.2",
		"effect": "3.22.0",
		"hono": "4.12.31",
		"hono-openapi": "1.3.1",
		"ioredis": "5.11.1",
		"nodemailer": "9.0.3",
		"octokit": "5.0.5",
		"pg": "8.22.0",
		"postgres": "3.4.7",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"valibot": "1.4.2",
		"zod": "4.4.3",
		"@kaneo/permissions": "workspace:*",
		"@kaneo/email": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.6",
		"@playwright/test": "1.62.0",
		"@types/bcryptjs": "^3.0.0",
		"@types/bun": "1.3.10",
		"@types/pg": "8",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"turbo": "2.8.17",
		"typescript": "5.8.3",
		"vitest": "4.1.10"
	},
	"overrides": {
		"better-auth": "1.6.25",
		"@better-auth/core": "1.6.25",
		"@better-auth/utils": "0.4.2",
		"zod": "4.4.3"
	}
}
