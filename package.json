{
	"name": "stellarc",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"workspaces": [
		"apps/*",
		"packages/*",
		"packages/contracts/src/legacy/permissions"
	],
	"scripts": {
		"test:integration": "bun --bun x vitest run --config vitest.integration.config.ts",
		"test:unit": "bun --bun x vitest run --config vitest.config.ts",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"typecheck:ui": "tsc --noEmit --pretty false -p apps/stellarc-ui/tsconfig.app.json",
		"build": "turbo run build",
		"desktop:build": "DESKTOP_API_URL=${DESKTOP_API_URL:-https://api.stellarc.dev} bash desktop/scripts/build-ui.sh && bun run --cwd desktop tauri build -c target/tauri.conf.build.json",
		"desktop:check": "cargo check --manifest-path desktop/Cargo.toml --all-targets",
		"e2e": "playwright test",
		"e2e:screens": "playwright test frozen.spec.ts",
		"otel:up": "docker compose -f docker-compose.otel.yml up -d"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "1.7.0",
		"@aws-sdk/client-s3": "3.1147.0",
		"@aws-sdk/s3-request-presigner": "3.1147.0",
		"@better-auth/api-key": "1.7.7",
		"@better-auth/drizzle-adapter": "1.7.7",
		"@effect/opentelemetry": "4.0.2",
		"@effect/platform-bun": "4.0.2",
		"@effect/sql-pg": "4.0.2",
		"@electric-sql/client": "1.5.28",
		"@hono/node-server": "2.1.4",
		"@hono/node-ws": "1.3.1",
		"@hono/standard-validator": "0.4.0",
		"@kaneo/email": "workspace:*",
		"@kaneo/permissions": "workspace:*",
		"@modelcontextprotocol/sdk": "1.32.1",
		"@octokit/webhooks": "14.2.0",
		"@opentelemetry/exporter-logs-otlp-http": "0.223.0",
		"@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
		"@opentelemetry/exporter-trace-otlp-http": "0.223.0",
		"@opentelemetry/sdk-logs": "0.223.0",
		"@opentelemetry/sdk-metrics": "2.12.0",
		"@opentelemetry/sdk-trace-base": "2.12.0",
		"@oslojs/crypto": "1.0.1",
		"@oslojs/encoding": "1.1.0",
		"@paralleldrive/cuid2": "3.3.0",
		"@react-email/components": "1.0.12",
		"@sentry/node": "11.5.0",
		"@tanstack/db": "0.12.3",
		"@tanstack/electric-db-collection": "0.5.8",
		"@types/node": "26.6.4",
		"@types/nodemailer": "8.0.2",
		"@valibot/to-json-schema": "1.8.0",
		"bcryptjs": "3.0.3",
		"better-auth": "1.7.7",
		"croner": "10.0.1",
		"dotenv-mono": "1.5.1",
		"drizzle-orm": "0.45.4",
		"effect": "4.0.2",
		"hono": "4.13.13",
		"hono-openapi": "1.3.5",
		"ioredis": "6.0.0",
		"nodemailer": "10.0.16",
		"octokit": "5.0.5",
		"pg": "8.23.1",
		"postgres": "3.4.9",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"valibot": "1.5.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@playwright/test": "1.64.0",
		"@types/bcryptjs": "3.0.0",
		"@types/bun": "1.4.2",
		"@types/pg": "8.23.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"turbo": "2.11.7",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	},
	"overrides": {
		"better-auth": "1.7.7",
		"@better-auth/core": "1.7.7",
		"zod": "4.6.5",
		"@better-auth/utils": "0.5.0"
	}
}
