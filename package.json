{
	"name": "stellarc",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"workspaces": [
		"apps/*",
		"packages/*",
		"packages/contracts/src/legacy/permissions"
	],
	"scripts": {
		"test:integration": "bun --bun x vitest run --config vitest.integration.config.ts",
		"test:unit": "bun --bun x vitest run --config vitest.config.ts",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"typecheck:ui": "tsc --noEmit --pretty false -p apps/stellarc-ui/tsconfig.app.json",
		"scope:audit": "bun tools/scope-audit/run.ts",
		"build": "turbo run build",
		"desktop:build": "DESKTOP_API_URL=${DESKTOP_API_URL:-https://api.stellarc.dev} bash desktop/scripts/build-ui.sh && bun run --cwd desktop tauri build -c target/tauri.conf.build.json",
		"desktop:check": "cargo check --manifest-path desktop/Cargo.toml --all-targets",
		"e2e": "playwright test",
		"e2e:screens": "playwright test frozen.spec.ts",
		"otel:up": "docker compose -f docker-compose.otel.yml up -d"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "2.4.0",
		"@aws-sdk/client-s3": "3.1164.0",
		"@aws-sdk/s3-request-presigner": "3.1164.0",
		"@better-auth/api-key": "1.7.18",
		"@better-auth/drizzle-adapter": "1.7.18",
		"@effect/opentelemetry": "4.1.4",
		"@effect/platform-bun": "4.1.4",
		"@effect/sql-pg": "4.1.4",		"@electric-sql/client": "1.5.28",
		"@hono/node-server": "2.1.6",
		"@hono/node-ws": "1.3.1",
		"@hono/standard-validator": "0.4.1",
		"@kaneo/email": "workspace:*",
		"@kaneo/permissions": "workspace:*",
		"@octokit/webhooks": "14.2.0",
		"@opentelemetry/exporter-logs-otlp-http": "0.301.0",
		"@opentelemetry/exporter-metrics-otlp-http": "0.301.0",
		"@opentelemetry/exporter-trace-otlp-http": "0.301.0",
		"@opentelemetry/sdk-logs": "3.1.0",
		"@opentelemetry/sdk-metrics": "3.1.0",
		"@opentelemetry/sdk-trace-base": "2.12.0",
		"@oslojs/crypto": "1.0.1",
		"@oslojs/encoding": "1.1.0",
		"@paralleldrive/cuid2": "3.3.0",
		"@react-email/components": "1.0.12",
		"@sentry/node": "11.11.0",
		"@tanstack/db": "1.0.0-rc.1.4",
		"@tanstack/electric-db-collection": "1.0.0-rc.1.4",
		"@types/node": "26.6.6",
		"@types/nodemailer": "8.0.2",
		"@valibot/to-json-schema": "1.8.0",
		"bcryptjs": "3.0.3",
		"better-auth": "1.7.18",
		"croner": "11.0.0",
		"dotenv-mono": "^1.5.1",
		"drizzle-orm": "0.45.4",
		"effect": "4.1.4",
		"hono": "4.13.17",
		"hono-openapi": "1.5.0",
		"ioredis": "6.0.0",
		"jose": "6.2.17",
		"nodemailer": "10.4.0",		"octokit": "5.0.5",
		"pg": "8.23.1",
		"postgres": "4.1.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"valibot": "1.5.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@durable-streams/client": "0.2.7",
		"@durable-streams/state": "0.3.2",
		"@playwright/test": "1.65.0",
		"@standard-schema/spec": "1.1.0",
		"@types/bcryptjs": "^3.0.0",
		"@types/bun": "1.4.4",
		"@types/pg": "8.23.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"knip": "6.45.1",
		"turbo": "2.11.10",
		"typescript": "5.8.3",
		"vitest": "5.1.0",
		"yaml": "2.9.1",
		"knip": "6.45.1"	},
	"overrides": {
		"@better-auth/core": "1.7.18",
		"@better-auth/utils": "0.5.1",
		"@opentelemetry/api": "1.10.0",
		"better-auth": "1.7.18",
		"zod": "4.6.7"
	},
	"optionalDependencies": {}
}
